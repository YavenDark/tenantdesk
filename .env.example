# Postgres connection (Supabase pooler). Session mode (5432) or transaction mode (6543) both work.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# TLS: "no-verify" (default, encrypted but CA not verified), "verify", or "disable" (local only)
DATABASE_SSL=no-verify
# Auth.js JWT signing secret: openssl rand -base64 32
AUTH_SECRET=
# Optional seed passwords (test-only defaults documented in README)
SEED_PASSWORD_ALICE=
SEED_PASSWORD_BOB=
SEED_PASSWORD_VERA=
